# Portal (Jinja frontend) settings. Copy to .env (git-ignored) -- or just run
# `python start.py` from the project root, which creates this file and fills
# in the token + session secret for you.
# Do NOT put CIS/Groq LLM keys here: only the pipeline API talks to the LLM.

# remote = call the pipeline API (required for the assessment workflow).
TALENT360_API_MODE=remote

# Pipeline API base URL. Must be https:// for anything except localhost.
# start.py overrides this with the port it starts the API on.
TALENT360_BACKEND_URL=http://127.0.0.1:8000
# Must equal TALENT360_BACKEND_TOKEN in the project-root .env (start.py syncs it).
TALENT360_BACKEND_TOKEN=
# /api/generate makes one LLM call per skill (generate + self-check, up to
# 2x on a failed self-check) -- a multi-skill role can take well over 60s.
TALENT360_API_TIMEOUT=300

# Session settings. Set TALENT360_DEBUG=false and a long random secret for any
# shared/deployed run (debug=false also turns on HSTS + Secure cookies):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TALENT360_DEBUG=true
TALENT360_SESSION_SECRET=
# Idle / absolute session limits in seconds (defaults shown)
# TALENT360_IDLE_TIMEOUT=1800
# TALENT360_SESSION_MAX_AGE=28800

# v3 employee lifecycle (see the project-root .env.example for details)
# TALENT360_NOTIFY_CHANNELS=in_app
# TALENT360_INTEGRATION_TOKEN=
# TALENT360_DB_PATH=

# v3.2 internal jobs: SmartRecruiters (Posting API). Leave the company id empty to use
# the bundled demo postings (data/smartrecruiters_demo_postings.json).
# SMARTRECRUITERS_COMPANY_ID=
# Optional X-SmartToken, for a tenant that restricts internal postings. Never logged or shown.
# SMARTRECRUITERS_API_TOKEN=
# Optional Posting API "destination" filter, e.g. INTERNAL (check your tenant's settings).
# SMARTRECRUITERS_DESTINATION=
# Must be an https smartrecruiters.com host (default shown).
# SMARTRECRUITERS_API_BASE=https://api.smartrecruiters.com
