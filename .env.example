# Copy to .env (git-ignored). NEVER commit real keys.
# `python start.py` does the copy for you and fills every EMPTY secret below
# (backend token, login passwords) with a random value stored in .env.
# The only value you must add yourself is the LLM key (GROQ_API_KEY or CIS_API_KEY).

# Which LLM backend agents/llm_client.py uses. "groq" (default) or "cis".
# NIQ GenAI guideline: only approved providers (Azure AI Services -> "cis")
# may be used with real data. Groq is for personal-machine development only
# and is refused when TALENT360_ENV=production/staging.
LLM_PROVIDER=groq
TALENT360_ENV=development

# --- Groq (personal machine / development) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Company CIS LLM gateway (Azure AI Inference) ---
CIS_LLM_ENDPOINT=https://llm-api-cis.azure-intlsd-np.nielsencsp.net/
# Include the "Bearer " prefix exactly as issued by the company.
CIS_API_KEY=
CIS_MODEL=hack-fest-gpt-5.6-luna
CIS_API_VERSION=2025-03-01-preview

# --- Pipeline API security ---
# Shared secret the portal sends as "Authorization: Bearer <token>".
# Required when TALENT360_DEBUG=false. start.py generates one and copies it
# into the portal's .env; or generate one yourself with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TALENT360_BACKEND_TOKEN=
TALENT360_DEBUG=true
# Limits (defaults shown)
# TALENT360_MAX_UPLOAD_BYTES=5242880
# TALENT360_MAX_RESUME_CHARS=20000
# TALENT360_MAX_ANSWER_CHARS=3000
# TALENT360_MAX_PROMPT_CHARS=24000
# LLM_TIMEOUT_SECONDS=90
# A rate-limited call (HTTP 429) waits as long as the provider asks, then retries:
# LLM_RATE_LIMIT_RETRIES=3
# LLM_RATE_LIMIT_MAX_WAIT=30
# Proctored assessments (services/integrity.py): strikes before auto-submit, how short a focus change
# is forgiven, the retake cool-off after a high-risk attempt, and whether full screen is required.
# TALENT360_INTEGRITY_MAX_STRIKES=3
# TALENT360_INTEGRITY_GRACE_SECONDS=2
# TALENT360_INTEGRITY_COOL_OFF_DAYS=7
# TALENT360_INTEGRITY_FULLSCREEN=true
# Log raw (redacted) prompts/responses for prompt-injection forensics. Off by default (PII).
# LLM_LOG_FULL_TEXT=false
# Where audit logs (logs/audit.jsonl, logs/llm.jsonl) are written.
# TALENT360_LOG_DIR=

# Password for the 6 demo role accounts (manager/employee/sme/scheduler/
# leader/admin) and the synthetic dataset accounts (Users_Teams sheet,
# SYN-U001..SYN-U036), both seeded by scripts/seed_users.py. Both are
# required -- the seed script refuses to run without them (no hardcoded
# default). start.py fills empty ones with a random password stored here, so
# it is never lost. After changing either value run `python start.py --reseed`.
TALENT360_DEMO_PASSWORD=
TALENT360_SYNTHETIC_PASSWORD=

# --- v3 employee lifecycle -----------------------------------------------------
# Notification channels: in_app always; add email and/or teams to also queue them
# in logs/outbox.jsonl for the Microsoft Graph sender.
# TALENT360_NOTIFY_CHANNELS=in_app
# Bearer token for /integrations/evidence (Power Automate / Graph flows that post
# messages a manager tagged). Empty = the endpoint is disabled.
# TALENT360_INTEGRATION_TOKEN=
# Point the portal and worker at another database file (e.g. the 20k scale dataset).
# TALENT360_DB_PATH=
