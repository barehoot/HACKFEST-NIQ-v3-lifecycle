# Environment for docker-compose.yml (copy to deploy/.env; git-ignored).
# One file for all services: each reads only what it needs.

TALENT360_ENV=staging
TALENT360_DEBUG=false

# --- LLM (only the API container uses these) ---------------------------------
# staging/production refuse Groq: use the approved CIS / Azure AI gateway.
LLM_PROVIDER=cis
CIS_LLM_ENDPOINT=https://llm-api-cis.azure-intlsd-np.nielsencsp.net/
CIS_API_KEY=
CIS_MODEL=hack-fest-gpt-5.6-luna
CIS_API_VERSION=2025-03-01-preview

# --- Secrets (generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
TALENT360_BACKEND_TOKEN=
TALENT360_SESSION_SECRET=
# Power Automate / Graph evidence ingestion (/integrations/evidence). Leave empty to keep it disabled.
TALENT360_INTEGRATION_TOKEN=

# Demo and synthetic login passwords used when `init` seeds accounts (12+ chars, mixed classes).
TALENT360_DEMO_PASSWORD=
TALENT360_SYNTHETIC_PASSWORD=

# --- Notifications -------------------------------------------------------------
# in_app always; add email and/or teams to also queue them in logs/outbox.jsonl
# for the Microsoft Graph sender.
TALENT360_NOTIFY_CHANNELS=in_app

# --- Session limits (seconds) ---------------------------------------------------
TALENT360_IDLE_TIMEOUT=1800
TALENT360_SESSION_MAX_AGE=28800
